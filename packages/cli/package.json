{
  "name": "@preflight-agent/cli",
  "version": "0.2.0",
  "description": "Pre-deploy security checklist CLI for vibe coders — secrets, RLS, auth, injection, dependency CVEs",
  "keywords": [
    "security",
    "scanner",
    "sast",
    "supabase",
    "rls",
    "secrets",
    "nextjs",
    "pre-deploy",
    "sarif"
  ],
  "homepage": "https://github.com/anomalyco/agent-preflight/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/anomalyco/agent-preflight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/agent-preflight.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/scan.js",
  "types": "dist/scan.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "preflight": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^7.0.2"
  }
}
